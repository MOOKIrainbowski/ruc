# 웹(Vercel)의 RPG_TICKET_SECRET 과 같은 값. 개발(npm run dev)에서는 비워도 됩니다.
RPG_TICKET_SECRET=
PORT=2567
# 웹소켓을 받을 사이트 주소 (쉼표로 구분)
RPG_ALLOWED_ORIGINS=http://localhost:3000,https://ruc-server.vercel.app
# GM (§28): 디스코드 ID 를 쉼표로 — 게임 안에서 F8 GM 창 · 채팅 /gm 명령 (개발 모드에서는 ?dev= 계정이 모두 GM)
RPG_GM_IDS=
# 버그 제보를 디스코드 채널로도 받으려면 웹훅 URL (없으면 DB 에만)
RPG_BUG_WEBHOOK=
