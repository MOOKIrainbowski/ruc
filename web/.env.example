# 화면에 표시할 접속 주소
NEXT_PUBLIC_MC_ADDRESS=play.rucserver.kr

# 상태 조회용 실제 호스트 (host 또는 host:port).
# 비워두면 해당 서버는 "준비 중"으로 표시됩니다 — 사이트는 정상 동작합니다.
MC_HOST_HOME=
MC_HOST_RAID=
MC_HOST_WAR=
MC_HOST_PEACE=

# ── 충전 (/charge) ───────────────────────────────────────────
# "true" 일 때만 계좌를 보여 줍니다. Vercel Hobby 는 상업적 이용 금지라서
# 통신판매업 신고 · 요금제 정리 전까지 운영에서는 비워 두세요 (docs/03-DEPLOY.md).
CHARGE_ENABLED=
# 저장소가 공개입니다 — 계좌번호는 .env.local / Vercel 환경변수에만 넣으세요.
TOSS_BANK=토스뱅크
TOSS_ACCOUNT=
TOSS_HOLDER=
