  "FIRST_QUEST": "tut_talk",
  "NPCS": {
    "lumi": {
      "name": "루미",
      "role": "안내원",
      "lines": [
        "어서 와요! 저는 안내원 루미예요. 햇살광장 솔라스에 온 걸 환영해요.",
        "모르는 게 있으면 언제든 말 걸어요. 퀘스트는 J 키로 볼 수 있어요."
      ]
    },
    "volt": {
      "name": "볼트",
      "role": "대장장이",
      "place": "대장간 열기",
      "lines": [
        "강화는 운이 반, 준비가 반이야. 보호 주문서 없이 +7 넘기는 건 추천 안 해.",
        "장비가 닳았으면 수리도 해 주지."
      ]
    },
    "mir": {
      "name": "미르",
      "role": "연금술사",
      "place": "작업대 열기",
      "lines": [
        "안 쓰는 장비 세 개를 가져오면 새 장비 하나로 바꿔 줄게요. 뭐가 나올지는 몰라요, 후후."
      ]
    },
    "sera": {
      "name": "세라",
      "role": "직업 교관",
      "place": "전직하기",
      "lines": [
        "Lv.10이 되면 1차 전직을, Lv.30이 되면 2차 전직을 할 수 있어요. 어떤 길을 걸을지 잘 생각해 보세요."
      ]
    },
    "owen": {
      "name": "오웬",
      "role": "스킬 교관",
      "place": "스킬창 열기",
      "lines": [
        "스킬은 쓸수록 숙련도가 쌓여서 강해져. 스킬북은 몬스터가 가끔 떨어뜨리지."
      ]
    },
    "pip": {
      "name": "핍",
      "role": "우편 집배원",
