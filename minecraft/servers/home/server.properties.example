# Ruc Server - Home
# WARNING: Do not expose this port. Proxy (25565) only.
# This file is ASCII-only on purpose: server.properties is a Java properties
# file and non-ASCII values get mangled by encoding round-trips.

server-port=25566
server-ip=127.0.0.1
online-mode=false
motd=Ruc Server - Home
max-players=100
view-distance=8
simulation-distance=6
enable-command-block=false
spawn-protection=0
allow-flight=true
white-list=false
difficulty=peaceful
gamemode=adventure
enable-rcon=true
rcon.port=25576
rcon.password=__GENERATED_AT_SETUP__
