# MOOKI — 환경 변수 예시
#
# 이 파일을 .env 로 복사하고 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ .env 는 절대 커밋하지 마세요. 저장소 .gitignore 에 이미 들어 있습니다.
# ⚠️ 토큰을 주석으로라도 이 파일에 적지 마세요. 주석도 파일에 남습니다.

# ── 디스코드 ──────────────────────────────────────────────────────────
# 개발자 포털 → 애플리케이션 → Bot → Reset Token
DISCORD_TOKEN=

# 서버(길드) ID. 채널/역할과 마찬가지로 개발자 모드를 켜고 우클릭 → ID 복사
GUILD_ID=

# 기본 알림 채널 ID
CHANNEL_ID=

# 보안 로그 채널 ID. 비워 두면 CHANNEL_ID 를 씁니다.
LOG_CHANNEL_ID=

# (구) 반응 역할용 역할 ID. 역할 설정은 config/roles.json 으로 옮겼습니다.
ROLE_ID=

# ── 마인크래프트 연동 (D10 인증 · 칭호 · 채팅 중계) ──────────────────
# RCON 으로 마크 서버에 명령을 보냅니다.
RUC_RCON_HOST=127.0.0.1
RUC_RCON_PORT=25576
RUC_RCON_PW=

# ── 마인크래프트 서버 상태 (/서버상태) ────────────────────────────────
# 상태 조회는 RCON 이 아니라 접속 포트로 합니다 (Server List Ping).
#
# 로컬 테스트 서버: 프록시 포트 25565
# 호스팅으로 옮긴 뒤: 아래 두 줄만 새 주소로 바꾸면 됩니다. 코드 수정 없음.
MC_STATUS_HOST=127.0.0.1
MC_STATUS_PORT=25565

# 사람에게 보여 줄 접속 주소. 내부 IP 를 그대로 노출하지 않으려고 따로 둡니다.
# 예: play.rucserver.kr
MC_PUBLIC_ADDRESS=

# ── 칭호 동기화 ───────────────────────────────────────────────────────
# 전체 훑기 주기 (분). 기본 30
RUC_TITLE_SWEEP_MIN=30

# ── 채팅 중계 ─────────────────────────────────────────────────────────
# 디스코드 → 인게임. 서버:채널ID 를 쉼표로 잇습니다.
# 인게임 → 디스코드는 봇이 아니라 플러그인이 웹훅으로 보냅니다
# (RucCore config.yml 의 relay.webhook-url).
RUC_RELAY_CHANNELS=

# 서버별 RCON 포트. 비워 두면 25576~25579 (home/raid/war/peace)
RUC_RCON_PORTS=home:25576,raid:25577,war:25578,peace:25579

# ── 제재 (/제재 · Phase 6-7) ─────────────────────────────────────────
# 제재 기록을 남길 채널. 비워 두면 LOG_CHANNEL_ID 를 씁니다.
SANCTION_LOG_CHANNEL_ID=
# 4단계 이상 승인 요청을 올릴 채널. 비워 두면 위 로그 채널로 갑니다.
# Manager 만 보이는 비공개 채널을 권장합니다.
SANCTION_APPROVAL_CHANNEL_ID=

# ── 현금 충전 (/충전 · docs/payment-design.md) ────────────────────────
# "true" 면 누구나 주문할 수 있습니다. 비워 두면 Manager 이상만 (시험용).
# 통신판매업 신고(Q5) 전에는 비워 두세요.
PAY_ENABLED=
# 유저에게 안내할 입금 계좌. 저장소가 공개라서 여기(.env)에만 적습니다.
PAY_BANK=토스뱅크
PAY_ACCOUNT=
PAY_HOLDER=
# 주문 확인 버튼 · 확인 대기 입금을 올릴 채널 (Manager 만 보이는 비공개 채널).
# 비워 두면 LOG_CHANNEL_ID 를 씁니다.
PAY_ADMIN_CHANNEL_ID=
# 상품표 경로. 비워 두면 ../web/content/products.json (웹과 같은 파일)
PAY_PRODUCTS_FILE=

# 입금 알림 자동 매칭 (A). 비워 두면 웹훅을 열지 않고 관리자 확인(D)만 씁니다.
# 알림 전달 앱과 같은 값을 넣습니다. 길고 무작위로: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAY_WEBHOOK_SECRET=
PAY_WEBHOOK_HOST=127.0.0.1
PAY_WEBHOOK_PORT=8790
# 입금 알림만 고르는 정규식 (기본: 입금|보냈|받았)
PAY_NOTIFY_FILTER=
# 금액 · 입금자명 추출 정규식 (이름 있는 그룹 amount, name). 비워 두면 첫 "N원" 을 금액으로,
# 원문 전체를 입금자명으로 넘깁니다 (서버가 원문에서 주문 코드를 찾습니다).
PAY_NOTIFY_REGEX=
# 최근 주문이 있는데 알림이 이 시간 동안 없으면 관리자에게 경고 (0 = 끔)
PAY_SILENCE_HOURS=6

# ── 구버전 키 — 어느 코드도 읽지 않습니다 ────────────────────────────
#
# ⚠️ RCON 비밀번호를 여기에 넣으면 아무 일도 일어나지 않습니다.
#    진짜 키는 위의 RUC_RCON_PW 입니다. 이름이 비슷해 실제로 한 번
#    혼동이 있었습니다.
#
# 새로 설정하는 경우 아래 세 줄은 그냥 지우셔도 됩니다.
MC_HOST=
MC_RCON_PORT=
MC_RCON_PW=
