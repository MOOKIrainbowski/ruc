# Minecraft RCON
MC_HOST=
MC_RCON_PORT=25575
MC_RCON_PW=

# 러크 서버 연동 (D10 인증 · 칭호 · 채팅 중계)
RUC_RCON_HOST=127.0.0.1
RUC_RCON_PORT=25576
RUC_RCON_PW=

# 칭호 동기화 — 전체 훑기 주기 (분). 기본 30
RUC_TITLE_SWEEP_MIN=30

# 디스코드 → 인게임 채팅 중계. 서버:채널ID 를 쉼표로 잇습니다.
# 인게임 → 디스코드는 봇이 아니라 플러그인이 웹훅으로 보냅니다
# (RucCore config.yml 의 relay.webhook-url).
RUC_RELAY_CHANNELS=

# 서버별 RCON 포트. 비워 두면 25576~25579 (home/raid/war/peace)
RUC_RCON_PORTS=home:25576,raid:25577,war:25578,peace:25579

# Database (Phase 6+)
DB_HOST=
