# secrets
.env
.env.local
*.env
!.env.example

# node
node_modules/
npm-debug.log*

# logs / runtime data
*.log
bot.log

# minecraft server runtime
# 주의: minecraft/**/world*/ 로 쓰면 자바 패키지 디렉터리(.../home/world/)까지
# 잡아먹습니다. 실제로 PlazaBuilder.java 가 커밋에서 빠졌던 적이 있어 경로를 좁혔습니다.
minecraft/servers/*/world*/
minecraft/servers/*/DIM*/
minecraft/**/plugins/**/*.jar
minecraft/**/cache/
minecraft/**/libraries/
minecraft/**/logs/
minecraft/**/*.jar
# Gradle 래퍼 jar은 예외 — 이게 없으면 클론 후 빌드가 불가능합니다
!minecraft/plugins/gradle/wrapper/gradle-wrapper.jar

# Paper/Velocity가 실행 중 만들어내는 것들
minecraft/servers/*/config/
minecraft/servers/*/versions/
minecraft/servers/*/eula.txt
minecraft/servers/*/ops.json
minecraft/servers/*/whitelist.json
minecraft/servers/*/permissions.yml
minecraft/servers/*/help.yml
minecraft/servers/*/bukkit.yml
minecraft/servers/*/spigot.yml
minecraft/servers/*/commands.yml
minecraft/proxy/logs/
minecraft/proxy/forwarding.secret
minecraft/proxy/velocity.toml.bak
# Velocity 가 기동 시 만드는 런타임 디렉터리
minecraft/proxy/lang/
minecraft/proxy/plugins/
minecraft/proxy/console.log
minecraft/servers/*/console.log
# Java 25 를 요구해 쓸 수 없는 4.x 스냅샷 보관본
minecraft/proxy/*.jar.bak
minecraft/servers/*/plugins/RucCore/data*.db
minecraft/servers/shared/
minecraft/servers/*/plugins/RucCore/*.db.old
minecraft/**/crash-reports/
minecraft/**/banned-*.json
minecraft/**/usercache.json

# java build
build/
.gradle/

# web
web/.next/
web/out/
web/.vercel/

# os
Thumbs.db
desktop.ini
.DS_Store

# 백업 파일 — .env.bak 등에 비밀정보가 그대로 들어갑니다
*.bak
.env.*
!.env.example

# server.properties 에는 rcon.password 가 들어갑니다.
# 템플릿(.example)만 추적하고 실제 파일은 setup.ps1 이 생성합니다.
minecraft/servers/*/server.properties

# Paper가 실행 중 생성하는 것들
minecraft/servers/*/plugins/.paper-remapped/
minecraft/servers/*/plugins/bStats/
minecraft/servers/*/plugins/spark/
minecraft/servers/*/version_history.json
# 메시지 파일은 jar에서 자동 추출됩니다. 원본은 plugins/RucCore/src/main/resources
minecraft/servers/*/plugins/RucCore/messages_*.yml
minecraft/servers/*/plugins/RucRaid/messages_*.yml

# 허브 월드는 플러그인이 코드로 생성합니다 (PlazaBuilder). 커밋 불필요.
minecraft/servers/*/hub/

# 학습용 참고 맵 (329MB, 타인 저작물). 저장소에 넣지 않습니다.
mapfile/
